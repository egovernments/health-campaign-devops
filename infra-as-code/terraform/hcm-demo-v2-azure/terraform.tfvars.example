environment    = "hcm-demo-v2"
resource_group = "hcm-demo-v2-rg"
location       = "centralindia"

# Must not overlap hcm-demo's 10.20.27.0/24 — the two environments may need to
# be peered during the data copy.
vnet_cidr            = "10.20.28.0/24"
aks_subnet_cidr      = "10.20.28.0/25"
postgres_subnet_cidr = "10.20.28.128/26"

# SKUs match live hcm-demo so the restore lands on identical sizing. Kubernetes
# deliberately runs ahead of the live demo's 1.34.
kubernetes_version = "1.35"
vm_size            = "Standard_E4s_v3"
node_count         = 8
node_min_count     = 1
node_max_count     = 8
os_disk_size_gb    = 128

db_version    = "15"
db_sku_name   = "GP_Standard_D2ds_v4"
db_storage_mb = 65536
db_name       = "healthdemo"
db_user       = "healthegovdemo"

# Do not commit the real value. Supply it at apply time instead:
#   export TF_VAR_db_password="$(az keyvault secret show --vault-name hcm-demo-v2-kv \
#     --name postgres-admin-password --query value -o tsv)"
db_password = "CHANGE_ME"

filestore_account_name = "egovfilestorehcmv2"
